<Project Sdk="Microsoft.NET.Sdk">

  <!--
    .NET binding for lib-wii-gamecube-kit. net8.0 and net10.0, so it runs on Windows,
    macOS, Linux and Android (net8.0-android and later apps can reference it).

    Two ways to use it:
      - As a NuGet package (dotnet pack): the native libraries found in
        artifacts/native/<rid> go in as runtimes/<rid>/native, and NuGet
        picks the right one for each platform, Android APKs included.
      - As a project reference (from a checkout or git submodule): the
        consuming app ships the native library for its platform next to
        itself, or imports build/lib-wii-gamecube-kit.Native.targets, which copies the
        one for the platform being built.
  -->

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>LibWiiGameCubeKit</RootNamespace>
    <AssemblyName>LibWiiGameCubeKit</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <Version>0.1.0</Version>
    <IsAotCompatible>true</IsAotCompatible>

    <PackageId>lib-wii-gamecube-kit</PackageId>
    <Authors>Nickel42</Authors>
    <Description>Dolphin's GameCube/Wii disc image conversion (RVZ, WIA, GCZ, ISO), probing and hashing as a .NET library, with native builds for Windows, macOS, Linux and Android.</Description>
    <PackageTags>gamecube;wii;rvz;wia;gcz;dolphin;disc-image</PackageTags>
    <PackageLicenseExpression>GPL-2.0-or-later</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Nickel42/lib-wii-gamecube-kit</RepositoryUrl>
    <!-- A package without native libraries would be useless; set to false only to try the managed side. -->
    <RequireNativeForPack Condition="'$(RequireNativeForPack)' == ''">true</RequireNativeForPack>
  </PropertyGroup>

  <PropertyGroup>
    <LibWiiGameCubeKitNativeRoot>$(MSBuildThisFileDirectory)../../../artifacts/native</LibWiiGameCubeKitNativeRoot>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../../README.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="../../../LICENSE" Pack="true" PackagePath="/" Visible="false" />
    <None Include="../../../THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="../../../vendor/BUNDLED_LICENSES.txt" Pack="true" PackagePath="/" Visible="false" />
    <None Include="build/lib-wii-gamecube-kit.Native.targets" Pack="false" />
  </ItemGroup>

  <!-- Every native build present goes in the package, under its .NET runtime identifier. -->
  <ItemGroup>
    <LibWiiGameCubeKitPackNative Include="$(LibWiiGameCubeKitNativeRoot)/win-x64/lib-wii-gamecube-kit.dll" Rid="win-x64" />
    <LibWiiGameCubeKitPackNative Include="$(LibWiiGameCubeKitNativeRoot)/win-arm64/lib-wii-gamecube-kit.dll" Rid="win-arm64" />
    <LibWiiGameCubeKitPackNative Include="$(LibWiiGameCubeKitNativeRoot)/osx/lib-wii-gamecube-kit.dylib" Rid="osx" />
    <LibWiiGameCubeKitPackNative Include="$(LibWiiGameCubeKitNativeRoot)/linux-x64/lib-wii-gamecube-kit.so" Rid="linux-x64" />
    <LibWiiGameCubeKitPackNative Include="$(LibWiiGameCubeKitNativeRoot)/linux-arm64/lib-wii-gamecube-kit.so" Rid="linux-arm64" />
    <LibWiiGameCubeKitPackNative Include="$(LibWiiGameCubeKitNativeRoot)/android-arm64/lib-wii-gamecube-kit.so" Rid="android-arm64" />
    <LibWiiGameCubeKitPackNative Include="$(LibWiiGameCubeKitNativeRoot)/android-x64/lib-wii-gamecube-kit.so" Rid="android-x64" />
  </ItemGroup>

  <Target Name="AddNativeToPackage" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <_LibWiiGameCubeKitPresentNative Include="@(LibWiiGameCubeKitPackNative)" Condition="Exists('%(LibWiiGameCubeKitPackNative.FullPath)')" />
      <_LibWiiGameCubeKitMissingNative Include="@(LibWiiGameCubeKitPackNative)" Condition="!Exists('%(LibWiiGameCubeKitPackNative.FullPath)')" />
      <None Include="@(_LibWiiGameCubeKitPresentNative)" Pack="true" PackagePath="runtimes/%(_LibWiiGameCubeKitPresentNative.Rid)/native/" />
    </ItemGroup>
    <Error Condition="'$(RequireNativeForPack)' == 'true' And '@(_LibWiiGameCubeKitMissingNative)' != ''"
           Text="Native builds missing from the package (build them with scripts/, or pass -p:RequireNativeForPack=false): @(_LibWiiGameCubeKitMissingNative->'%(FullPath)', ', ')" />
  </Target>

</Project>
